# Copy to deploy/.env and replace every value.
POSTGRES_DB=vitrina
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
ASPNETCORE_ENVIRONMENT=Production
APP_PORT=5080
FRONTEND_ORIGIN=https://vitrina.example.com
FRONTEND_BASE_URL=https://vitrina.example.com
EMAIL_CONFIRMATION_PATH=/auth/confirm-email
PASSWORD_RESET_PATH=/auth/reset-password
COMPANY_INVITATION_PATH=/invitations/accept
PRIVACY_POLICY_VERSION=v1

# SMTP: required for registration confirmation and company invitations.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=mailer@example.com
SMTP_USE_SSL=false

# MinIO private object storage. Files are served only through authenticated API endpoints.
MINIO_ROOT_USER=vitrina-storage
MINIO_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD

# File upload limit (25 MiB by default).
STORAGE_MAX_FILE_SIZE_BYTES=26214400

# Schema bootstrap is intended only for the first empty installation.
DATABASE_BOOTSTRAP_SCHEMA=false
DATABASE_ALLOW_PRODUCTION_BOOTSTRAP=false
